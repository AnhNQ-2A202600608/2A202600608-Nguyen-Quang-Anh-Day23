# === LLM Provider ===
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=256
USE_LLM_JUDGE=false

# === LangGraph ===
LANGGRAPH_INTERRUPT=false

# === Persistence ===
CHECKPOINTER=sqlite
SQLITE_DB_PATH=outputs/checkpoints.db

# === LangSmith (optional) ===
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-agent-lab

# === Logging ===
LOG_LEVEL=INFO
